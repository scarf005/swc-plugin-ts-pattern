{
  "name": "@scarf005/swc-plugin-ts-pattern",
  "version": "0.2.0-alpha.0",
  "license": "AGPL-3.0-only",
  "fmt": {
    "semiColons": false,
    "proseWrap": "never"
  },
  "exports": {
    ".": "./transform.mjs",
    "./loader": "./loader.mjs",
    "./register": "./register.mjs",
    "./run": "./run.mjs",
    "./transform": "./transform.mjs"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@swc/core": "npm:@swc/core@1.15.33"
  },
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "publish": {
    "include": [
      "README.md",
      "loader.mjs",
      "register.mjs",
      "run.mjs",
      "transform.mjs",
      "loader.d.ts",
      "register.d.ts",
      "run.d.ts",
      "transform.d.ts",
      "target/wasm32-wasip1/release/swc_plugin_ts_pattern.wasm.bin"
    ]
  },
  "allowScripts": [
    "npm:@swc/core@1.15.33"
  ]
}
