{
  "name": "@scarf005/swc-plugin-ts-pattern",
  "version": "0.2.0-alpha.0",
  "description": "SWC plugin that compiles supported ts-pattern match expressions into plain JavaScript control flow",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "commonjs",
  "main": "target/wasm32-wasip1/release/swc_plugin_ts_pattern.wasm.bin",
  "exports": {
    ".": "./target/wasm32-wasip1/release/swc_plugin_ts_pattern.wasm.bin",
    "./wasm": "./target/wasm32-wasip1/release/swc_plugin_ts_pattern.wasm.bin",
    "./loader": {
      "types": "./loader.d.ts",
      "default": "./loader.mjs"
    },
    "./register": {
      "types": "./register.d.ts",
      "default": "./register.mjs"
    },
    "./run": {
      "types": "./run.d.ts",
      "default": "./run.mjs"
    },
    "./transform": {
      "types": "./transform.d.ts",
      "default": "./transform.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ts-pattern-swc": "run.mjs"
  },
  "files": [
    "target/wasm32-wasip1/release/swc_plugin_ts_pattern.wasm.bin",
    "loader.mjs",
    "register.mjs",
    "run.mjs",
    "transform.mjs",
    "loader.d.ts",
    "register.d.ts",
    "run.d.ts",
    "transform.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "cargo build --release --target wasm32-wasip1 && cp target/wasm32-wasip1/release/swc_plugin_ts_pattern.wasm target/wasm32-wasip1/release/swc_plugin_ts_pattern.wasm.bin",
    "test": "cargo test && npm run build && npm run test:runtime",
    "test:runtime": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "swc-plugin",
    "ts-pattern",
    "pattern-matching"
  ],
  "dependencies": {
    "@swc/core": "1.15.33"
  },
  "peerDependencies": {
    "ts-pattern": ">=5.0.0"
  },
  "devDependencies": {
    "@swc/binding_core_wasm": "https://github.com/scarf005/swc-wasm/releases/download/binding-core-wasm-plugin-v1.15.33-plugin.1/swc-binding_core_wasm-1.15.33.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarf005/swc-plugin-ts-pattern.git"
  },
  "bugs": {
    "url": "https://github.com/scarf005/swc-plugin-ts-pattern/issues"
  },
  "homepage": "https://github.com/scarf005/swc-plugin-ts-pattern#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
